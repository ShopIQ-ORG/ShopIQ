schema {
  query: QueryRoot
  mutation: Mutation
}

scalar DateTime
scalar URL
scalar Money

type QueryRoot {
  product(id: ID!): Product
  products(
    first: Int
    after: String
    last: Int
    before: String
    query: String
    sortKey: ProductSortKeys
    reverse: Boolean
  ): ProductConnection!
  collections(
    first: Int
    after: String
    last: Int
    before: String
    query: String
  ): CollectionConnection!
  collection(id: ID!): Collection
  translatableResource(resourceId: ID!): TranslatableResource
}

type TranslatableResource {
  resourceId: ID!
  translations(locale: String!): [Translation!]!
}

type Translation {
  key: String!
  value: String!
  outdated: Boolean!
}

enum ProductSortKeys {
  TITLE
  PRODUCT_TYPE
  VENDOR
  UPDATED_AT
  CREATED_AT
  BEST_SELLING
  PRICE
  ID
  RELEVANCE
}

type ProductConnection {
  edges: [ProductEdge!]!
  pageInfo: PageInfo!
}

type ProductEdge {
  cursor: String!
  node: Product!
}

type Product {
  id: ID!
  title: String!
  description: String!
  handle: String!
  productType: String!
  vendor: String!
  tags: [String!]!
  priceRange: ProductPriceRange!
  priceRangeV2: ProductPriceRange!
  images(first: Int, after: String): ImageConnection!
  variants(first: Int, after: String): ProductVariantConnection!
  createdAt: DateTime!
  updatedAt: DateTime!
  metafield(namespace: String!, key: String!): Metafield
}

type ProductPriceRange {
  minVariantPrice: MoneyV2!
  maxVariantPrice: MoneyV2!
}

type MoneyV2 {
  amount: String!
  currencyCode: CurrencyCode!
}

enum CurrencyCode {
  USD
  EUR
  GBP
  EGP
  SAR
  AED
  CAD
  AUD
  JPY
  CNY
  INR
}

type ImageConnection {
  edges: [ImageEdge!]!
  pageInfo: PageInfo!
}

type ImageEdge {
  cursor: String!
  node: Image!
}

type Image {
  id: ID
  url: URL!
  altText: String
  width: Int
  height: Int
}

type ProductVariantConnection {
  edges: [ProductVariantEdge!]!
  pageInfo: PageInfo!
}

type ProductVariantEdge {
  cursor: String!
  node: ProductVariant!
}

type ProductVariant {
  id: ID!
  title: String!
  price: Money!
  availableForSale: Boolean!
  quantityAvailable: Int
  image: Image
  sku: String
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

enum CollectionSortKeys {
  TITLE
  ID
  HANDLE
  RELEVANCE
  UPDATED_AT
}

type CollectionConnection {
  edges: [CollectionEdge!]!
  nodes: [Collection!]!
  pageInfo: PageInfo!
}

type CollectionEdge {
  cursor: String!
  node: Collection!
}

type Collection {
  id: ID!
  title: String!
  handle: String!
  image: Image
  productsCount: CollectionProductsCount!
  products(first: Int, after: String): ProductConnection!
}

type CollectionProductsCount {
  count: Int!
}

type Metafield {
  id: ID!
  namespace: String!
  key: String!
  value: String!
  type: String!
  references(first: Int, after: String, last: Int, before: String): MetafieldReferenceConnection
}

type MetafieldReferenceConnection {
  edges: [MetafieldReferenceEdge!]!
  pageInfo: PageInfo!
}

type MetafieldReferenceEdge {
  cursor: String!
  node: MetafieldReference!
}

union MetafieldReference = Metaobject | Product

type Metaobject {
  id: ID!
  handle: String!
  type: String!
  updatedAt: DateTime
  field(key: String!): MetaobjectField
}

type MetaobjectField {
  key: String!
  value: String
  type: String!
}

type Mutation {
  metaobjectCreate(metaobject: MetaobjectCreateInput!): MetaobjectCreatePayload
  metafieldsSet(metafields: [MetafieldsSetInput!]!): MetafieldsSetPayload
  metaobjectUpdate(id: ID!, metaobject: MetaobjectUpdateInput!): MetaobjectUpdatePayload
  metaobjectDelete(id: ID!): MetaobjectDeletePayload
}

input MetaobjectCreateInput {
  type: String!
  handle: String
  capabilities: MetaobjectCapabilitiesInput
  fields: [MetaobjectFieldInput!]
}

input MetaobjectCapabilitiesInput {
  publishable: MetaobjectPublishableCapabilityInput
}

input MetaobjectPublishableCapabilityInput {
  status: MetaobjectPublishableStatus!
}

enum MetaobjectPublishableStatus {
  ACTIVE
  DRAFT
}

input MetaobjectFieldInput {
  key: String!
  value: String
}

type MetaobjectCreatePayload {
  metaobject: Metaobject
  userErrors: [MetaobjectUserError!]!
}

type MetaobjectUserError {
  field: [String!]
  message: String!
  code: String
}

input MetafieldsSetInput {
  ownerId: ID!
  namespace: String!
  key: String!
  value: String!
  type: String!
}

type MetafieldsSetPayload {
  metafields: [Metafield!]
  userErrors: [MetafieldUserError!]!
}

type MetafieldUserError {
  field: [String!]
  message: String!
  code: String
}

input MetaobjectUpdateInput {
  capabilities: MetaobjectCapabilitiesInput
  fields: [MetaobjectFieldInput!]
}

type MetaobjectUpdatePayload {
  metaobject: Metaobject
  userErrors: [MetaobjectUserError!]!
}

type MetaobjectDeletePayload {
  deletedId: ID
  userErrors: [MetaobjectUserError!]!
}