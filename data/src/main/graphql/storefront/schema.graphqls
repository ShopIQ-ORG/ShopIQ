schema {
  query: QueryRoot
  mutation: Mutation
}

scalar DateTime
scalar URL

type QueryRoot {
  cart(id: ID!): Cart

  # Orders only exist behind the customer connection — there is no root-level
  # order(id:) lookup on the Storefront API, so don't add one back.
  customer(customerAccessToken: String!): Customer
}

type Mutation {
  cartCreate(input: CartInput!): CartCreatePayload
  cartLinesAdd(cartId: ID!, lines: [CartLineInput!]!): CartLinesAddPayload
  cartLinesUpdate(cartId: ID!, lines: [CartLineUpdateInput!]!): CartLinesUpdatePayload
  cartLinesRemove(cartId: ID!, lineIds: [ID!]!): CartLinesRemovePayload
  cartDiscountCodesUpdate(cartId: ID!, discountCodes: [String!]!): CartDiscountCodesUpdatePayload
  cartBuyerIdentityUpdate(cartId: ID!, buyerIdentity: CartBuyerIdentityInput!): CartBuyerIdentityUpdatePayload

  customerCreate(input: CustomerCreateInput!): CustomerCreatePayload
  customerAccessTokenCreate(input: CustomerAccessTokenCreateInput!): CustomerAccessTokenCreatePayload
  customerAccessTokenRenew(customerAccessToken: String!): CustomerAccessTokenRenewPayload
}

# ---------- Cart ----------

type Cart {
  id: ID!
  checkoutUrl: URL!
  lines(first: Int): CartLineConnection!
  discountCodes: [CartDiscountCode!]!
  cost: CartCost!
  buyerIdentity: CartBuyerIdentity
  deliveryGroups(first: Int): CartDeliveryGroupConnection!
}

type CartLineConnection {
  edges: [CartLineEdge!]!
}

type CartLineEdge {
  node: CartLine!
}

type CartLine {
  id: ID!
  quantity: Int!
  cost: CartLineCost!
  merchandise: CartLineMerchandise!
}

type CartLineCost {
  amountPerQuantity: MoneyV2!
  subtotalAmount: MoneyV2!
  totalAmount: MoneyV2!
}

interface CartLineMerchandise {
  __typename: String!
}

type ProductVariant implements CartLineMerchandise {
  id: ID!
  title: String!
  sku: String
  image: Image
  price: MoneyV2!
  compareAtPrice: MoneyV2
  selectedOptions: [SelectedOption!]!
  product: Product!
  availableForSale: Boolean!
  quantityAvailable: Int
}

type Product {
  id: ID!
  title: String!
  handle: String!
  featuredImage: Image
  vendor: String
}

type Image {
  id: ID
  url: URL!
  altText: String
}

type SelectedOption {
  name: String!
  value: String!
}

type CartDiscountCode {
  code: String!
  applicable: Boolean!
}

type CartCost {
  subtotalAmount: MoneyV2!
  totalAmount: MoneyV2!
  totalTaxAmount: MoneyV2
  totalDutyAmount: MoneyV2
}

type CartBuyerIdentity {
  email: String
  phone: String
  countryCode: String
}

input CartInput {
  lines: [CartLineInput!]
  buyerIdentity: CartBuyerIdentityInput
}

input CartLineInput {
  merchandiseId: ID!
  quantity: Int!
}

input CartLineUpdateInput {
  id: ID!
  quantity: Int!
}

input CartBuyerIdentityInput {
  email: String
  customerAccessToken: String
}

type CartCreatePayload {
  cart: Cart
  userErrors: [UserError!]!
}

type CartLinesAddPayload {
  cart: Cart
  userErrors: [UserError!]!
}

type CartLinesUpdatePayload {
  cart: Cart
  userErrors: [UserError!]!
}

type CartLinesRemovePayload {
  cart: Cart
  userErrors: [UserError!]!
}

type CartDiscountCodesUpdatePayload {
  cart: Cart
  userErrors: [UserError!]!
}

type CartBuyerIdentityUpdatePayload {
  cart: Cart
  userErrors: [UserError!]!
}

type CartDeliveryGroupConnection {
  edges: [CartDeliveryGroupEdge!]!
}

type CartDeliveryGroupEdge {
  node: CartDeliveryGroup!
}

type CartDeliveryGroup {
  id: ID!
  deliveryOptions: [CartDeliveryOption!]!
  selectedDeliveryOption: CartDeliveryOption
}

type CartDeliveryOption {
  handle: String!
  title: String
  estimatedCost: MoneyV2!
}

# ---------- Customer ----------

type Customer {
  id: ID!
  email: String
  firstName: String
  lastName: String
  phone: String
  orders(first: Int!): OrderConnection!
}

type CustomerAccessToken {
  accessToken: String!
  expiresAt: String!
}

input CustomerCreateInput {
  email: String!
  password: String!
  firstName: String
  lastName: String
  phone: String
  acceptsMarketing: Boolean
}

input CustomerAccessTokenCreateInput {
  email: String!
  password: String!
}

type CustomerCreatePayload {
  customer: Customer
  customerUserErrors: [CustomerUserError!]!
}

type CustomerAccessTokenCreatePayload {
  customerAccessToken: CustomerAccessToken
  customerUserErrors: [CustomerUserError!]!
}

type CustomerAccessTokenRenewPayload {
  customerAccessToken: CustomerAccessToken
  userErrors: [UserError!]!
}

type CustomerUserError {
  field: [String!]
  message: String!
  code: CustomerErrorCode
}

enum CustomerErrorCode {
  BLANK
  INVALID
  TAKEN
  TOO_LONG
  TOO_SHORT
  UNIDENTIFIED_CUSTOMER
  CUSTOMER_DISABLED
  PASSWORD_STARTS_OR_ENDS_WITH_WHITESPACE
  CONTAINS_HTML_TAGS
  CONTAINS_URL
  TOKEN_INVALID
}

# ---------- Orders ----------
# One connection, `nodes` shorthand only — the app always wants the full
# order payload in one shot, there's no separate "details" fetch anymore.

type OrderConnection {
  nodes: [Order!]!
}

type Order {
  id: ID!
  name: String!
  processedAt: DateTime!

  financialStatus: OrderFinancialStatus!
  fulfillmentStatus: OrderFulfillmentStatus!

  subtotalPrice: MoneyV2!
  totalShippingPrice: MoneyV2!
  totalPrice: MoneyV2!
  totalRefunded: MoneyV2!
  totalTax: MoneyV2!

  shippingAddress: MailingAddress
  lineItems(first: Int!): OrderLineItemConnection!
}

enum OrderFinancialStatus {
  PENDING
  AUTHORIZED
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
  EXPIRED
}

enum OrderFulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  RESTOCKED
  PENDING_FULFILLMENT
  OPEN
  IN_PROGRESS
  ON_HOLD
  SCHEDULED
}

type MailingAddress {
  firstName: String
  lastName: String
  address1: String
  city: String
  country: String
  zip: String
}

type OrderLineItemConnection {
  nodes: [OrderLineItem!]!
}

type OrderLineItem {
  title: String!
  quantity: Int!
  currentQuantity: Int!
  originalTotalPrice: MoneyV2!
  discountedTotalPrice: MoneyV2!
  variant: ProductVariant
}

# ---------- Shared ----------

type MoneyV2 {
  amount: String!
  currencyCode: CurrencyCode!
}

enum CurrencyCode {
  USD
  EUR
  GBP
  EGP
  SAR
  AED
  CAD
  AUD
  JPY
  CNY
  INR
}

type UserError {
  field: [String!]
  message: String!
}
